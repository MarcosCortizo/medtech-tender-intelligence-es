	column publication_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 2998893d-8735-46ea-8147-b87819b0e285
		summarizeBy: none
		sourceColumn: publication_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Contract End' = VAR s = IF ( v_lot_latest[status] = "result", COALESCE ( v_lot_latest[contract_date], v_lot_latest[publication_date] ) ) VAR n = v_lot_latest[duration_value] RETURN IF ( NOT ISBLANK ( s ) && NOT ISBLANK ( n ), SWITCH ( v_lot_latest[duration_unit], "MONTH", EDATE ( s, n ), "YEAR", EDATE ( s, 12 * n ), "DAY", s + n ) )
		dataType: dateTime
		formatString: Short Date
		lineageTag: 18a3680f-11b9-4425-95ad-13dfa04b0002
		summarizeBy: none

	partition v_lot_latest = m
		mode: import
		source =
				let
				    Source = Sql.Database("tender-marcos-se.database.windows.net", "tenderdb"),
				    dbo_v_lot_latest = Source{[Schema="dbo",Item="v_lot_latest"]}[Data]
				in
				    dbo_v_lot_latest

	annotation PBI_ResultType = Table

