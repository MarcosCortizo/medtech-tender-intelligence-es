model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["v_lot_latest","buyer","supplier","etl_run_log","dq_check_result"]

annotation PBI_ProTooling = ["DevMode"]

ref table v_lot_latest
ref table buyer
ref table supplier
ref table etl_run_log
ref table dq_check_result
ref table Date

ref cultureInfo en-US

