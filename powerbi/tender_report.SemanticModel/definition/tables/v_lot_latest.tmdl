table v_lot_latest
	lineageTag: cb48fb49-88ee-4283-bb6d-ba7ea07e3c45

	measure Lots = COUNTROWS ( v_lot_latest )
		formatString: 0
		lineageTag: 58953604-aaa2-4902-bc4d-1274dd984754

	measure 'Awarded Value' = SUM ( v_lot_latest[awarded_value] )
		formatString: #,0
		lineageTag: 931f13f3-d2ac-4eee-8764-1ef0f5f3ef0a

	measure 'Supplier Share %' = DIVIDE ( [Awarded Value], CALCULATE ( [Awarded Value], ALL ( supplier ), NOT ISBLANK ( v_lot_latest[supplier_id] ) ) )
		formatString: 0.0%
		lineageTag: 6861f2e7-4087-450d-bf82-38ff1ed0137f

	measure 'Open Lots 30d' = CALCULATE ( [Lots], v_lot_latest[status] = "open", v_lot_latest[deadline_date] <= TODAY () + 30 )
		formatString: 0
		lineageTag: 8f0a928e-3a08-47bd-b641-66baba9a9abe

	measure 'Open Estimated Value' = CALCULATE ( SUM ( v_lot_latest[estimated_value] ), v_lot_latest[status] = "open" )
		formatString: #,0
		lineageTag: 249249a3-8e4b-479f-a952-559dad44ef95

	measure 'Award to Estimate' = MEDIANX ( FILTER ( v_lot_latest, v_lot_latest[awarded_value] > 0 && v_lot_latest[estimated_value] > 0 ), v_lot_latest[awarded_value] / v_lot_latest[estimated_value] )
		formatString: 0.00
		lineageTag: e43c9b22-4247-4664-9b3c-8524048df367

	measure 'Avg Bids' = AVERAGE ( v_lot_latest[tenders_received] )
		formatString: 0.0
		lineageTag: 04022460-9272-44bf-b727-f532a5de76ba

	measure 'Estimated Value' = SUM ( v_lot_latest[estimated_value] )
		formatString: #,0
		lineageTag: 1ffbff7a-ab28-4a5c-80f3-7421bcff8af8

	measure 'Awarded Lots' = CALCULATE ( [Lots], v_lot_latest[status] = "result" )
		formatString: 0
		lineageTag: bbee03a5-190a-4100-bb55-c219fb4073e5

	measure 'Closed No Result' = CALCULATE ( [Lots], v_lot_latest[status] = "closed, no result yet" )
		formatString: 0
		lineageTag: e037473f-1e5e-431a-a410-3bbd58424f29

	measure 'Next Deadline' = CALCULATE ( MIN ( v_lot_latest[deadline_date] ), v_lot_latest[status] = "open" )
		formatString: dd mmm yyyy
		lineageTag: df93914a-901e-45b7-90de-45b980948c74

	measure 'Days Left' = DATEDIFF ( TODAY (), MAX ( v_lot_latest[deadline_date] ), DAY )
		formatString: 0
		lineageTag: 06ec32c6-5ac7-408b-830c-effdf12dce8d

	measure 'Re-tenders 12m' = CALCULATE ( [Lots], v_lot_latest[Contract End] >= TODAY (), v_lot_latest[Contract End] <= TODAY () + 365 )
		formatString: 0
		lineageTag: bd9924c6-6508-4f03-bdb6-e51b3d77a704

	measure 'Supplier Coverage %' = DIVIDE ( CALCULATE ( [Lots], v_lot_latest[status] = "result", NOT ISBLANK ( v_lot_latest[supplier_id] ) ), [Awarded Lots] )
		formatString: 0.0%
		lineageTag: 9b032178-a8a1-45af-8b6b-0653f27908c1

	measure 'Value Without Supplier' = CALCULATE ( [Awarded Value], ISBLANK ( v_lot_latest[supplier_id] ) )
		formatString: #,0
		lineageTag: d07a7867-a7f4-4af8-8a35-1fe0a37c1870

	measure 'Last Run' = MAX ( etl_run_log[started_at] )
		formatString: dd/mm/yyyy hh:nn
		lineageTag: e82fe5c9-4b61-44d8-9051-aa7cdd3bf7eb

	measure 'Runs OK' = CALCULATE ( COUNTROWS ( etl_run_log ), etl_run_log[status] = "OK" )
		formatString: 0
		lineageTag: 2d6191f0-0a4f-46f7-bf6e-9e7100a9f420

